{
  "name": "dsh-chatterbox",
  "version": "1.0.0",
  "description": "dsh-chatterbox: loopback push-to-talk ingest that admits spoken text into one fixed DSH conversation, whose agent answers in Japanese with the configured voice profile",
  "type": "module",
  "main": "src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./protocol": "./src/host/protocol.js",
    "./client": {
      "default": "./src/client/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src",
    "tools",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "deps",
    "CHANGELOG.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "license": "GPL-3.0-only"
}

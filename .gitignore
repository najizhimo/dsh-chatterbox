# dsh-chatterbox — 不进入版本库的内容
#
# 原则：**私有件、机器状态、大体积运行时**一律忽略；公开仓库只留代码、文档、
# 公有领域演示音色与下载清单。

# ---------------------------------------------------------------- 私有角色
# 自己的人格包若不想公开，命名成 *.local.json 即可被忽略。
personas/*.local.json

# ---------------------------------------------------------------- 私有音色
# deps/voices 下只保留公有领域演示档案；其它 cb_*（自购素材参考音）不进库。
deps/voices/*
!deps/voices/cb_Demo_CC0/

# ---------------------------------------------------------------- 大体积依赖
# 由 tools/bootstrap.ps1 + deps/manifest.json 在本地下载，不进仓库。
deps/models/
deps/hf-cache/
deps/irodori/
deps/.tmp/

# ---------------------------------------------------------------- 运行时产物
out/
logs/
*.log
*.wav
# 演示档案的参考音必须保留（上面的 *.wav 会误伤）
!deps/voices/cb_Demo_CC0/samples/*.wav

# ---------------------------------------------------------------- 本机状态
# 正常位于 %LOCALAPPDATA%\dsh\dsh-chatterbox，若从插件目录运行也会落在这里。
paths.json
glossary.json
audio-pad.json
*.local.json

# ---------------------------------------------------------------- 依赖与缓存
node_modules/
.pnpm-store/
__pycache__/
*.pyc

# ---------------------------------------------------------------- 编辑器/系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------- 临时脚本
tests/_proto-preview.mjs

# 注：pnpm-lock.yaml **要提交**（依赖可复现）；LICENSE 也必须提交。
